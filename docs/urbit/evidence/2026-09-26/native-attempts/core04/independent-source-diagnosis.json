  "findings": [
    {
      "classification": "confirmed-source-lifecycle-gap",
      "evidence": [
        "delivery_suite.py:319 requests timeout=5.",
        "core_conn.py:145-168 closes its AF_UNIX channel when read_exact raises at that deadline.",
        "stead-client.hoon:11 wraps the remote watch in set-timeout 55 seconds.",
        "core_test.py:264-277 immediately relaunches home when attempt returns, with no terminal drain, native cancellation or sender-liveness fence.",
        "Transport line2168 records an encoded request, response-header timeout and zero received frame bytes."
      ],
      "id": "F1",
      "implication": "The native request may complete later and attempt to write to an abandoned control connection. A five-second host timeout proves no timely observed result, not native request termination.",
      "severity": "high",
      "title": "The unavailable-home caller abandons a live native request before its native timeout."
    },
    {
      "classification": "confirmed-source-admission-weakness",
      "evidence": [
        "delivery_suite.py:324-327 accepts ECONNREFUSED/EHOSTUNREACH/ENETUNREACH/ETIMEDOUT as supported unreachable.",
        "The host connection is to the live sender bus .urb/conn.sock, not directly to the stopped zod home.",
        "Line2171 actually reports connection refusal at that local connect stage after the bus crash."
      ],
      "id": "F2",
      "implication": "A dead or broken sender/host transport must fail infrastructure admission; it cannot prove the intended stopped-home behavior.",
      "severity": "high",
      "title": "Local sender control-socket refusal can be mislabeled as remote home unavailability."
    },
    {
      "classification": "confirmed-incomplete-native-schedule",
      "evidence": [
        "ended_leave starts with a home snapshot and self.recover(self.command) before fresh watch and leave-ended.",
        "The last case contains only the successful home-snapshot assertion; line2171 is its initial bus receipt read.",
        "No ended_leave_transport evidence exists in this attempt."
      ],
      "id": "F3",
      "implication": "Do not classify the old leave action as disproved or passed; preserve the raw failed case and rerun it after fixing the preceding lifetime boundary.",
      "severity": "high",
      "title": "The ended-leave action itself was never reached."
    },
    {
      "classification": "plausible-crash-trigger-not-proven-root-cause",
      "evidence": [
        "Home restarted at20:16:40 and was ready20:16:42, well before the 55-second native timeout.",
        "Two fresh zod snapshots preserve the same business state after restart.",
        "Retained bus log has newt broken pipe immediately before external fault0 and stack frame u3_king_commence king.c1093.",
        "Supervisor records bus exit-11; the guard failed on owned sandbox exit and never thermally stopped."
      ],
      "id": "F4",
      "limits": "This review has no process memory image, exact bus-thread state or controlled reproduction. It does not prove socket abandonment caused the fault or identify the faulty C instruction. Legal socket closure exposing a runtime bug remains possible.",
      "severity": "medium",
      "title": "An orphaned late reply is consistent with the observed broken pipe then SIGSEGV."
    }
  ],

.markdown{font-size:1rem;line-height:1.65;max-width:800px;overflow-wrap:anywhere}.markdown h1,.markdown h2,.markdown h3,.markdown h4,.markdown h5,.markdown h6{line-height:1.3;margin:1.4em 0 .6em}.markdown h1{font-size:1.75rem}.markdown h2{font-size:1.5rem}.markdown h3{font-size:1.25rem}.markdown p,.markdown ul,.markdown ol,.markdown blockquote{margin:.7em 0}.markdown ul,.markdown ol{padding-inline-start:1.7em}.markdown li+li{margin-top:.2em}.markdown blockquote{border-inline-start:3px solid var(--border,#dedcd5);padding-inline-start:1em;color:var(--muted,#63665f)}.markdown pre{overflow:auto;max-width:100%;padding:1rem;border-radius:8px;background:var(--background,#f7f7f5);white-space:pre}.markdown code{font-family:ui-monospace,monospace;font-size:.85em}.markdown :not(pre)>code{padding:.1em .3em;background:var(--background,#f7f7f5);border-radius:3px}.markdown-table{overflow:auto;max-width:100%;margin:1rem 0}.markdown table{border-collapse:collapse;width:100%;font-size:.95rem}.markdown th,.markdown td{border:1px solid var(--border,#dedcd5);padding:.5em .7em;text-align:start}.markdown a{color:var(--accent,#5b50bd);text-decoration:underline;text-underline-offset:3px}.markdown input[type=checkbox]{display:inline-block;width:auto;inline-size:1em;block-size:1em;padding:0;margin:0 .5em 0 0;vertical-align:-.1em;accent-color:var(--accent,#5b50bd)}.markdown-attachment{display:inline-block;border:1px solid var(--border,#dedcd5);border-radius:6px;padding:.3em .6em}.markdown .markdown-plain{white-space:pre-wrap}

nt:12px var(--mono)}.document-editor textarea{margin-bottom:0;min-height:290px;line-height:1.6;font-family:var(--mono)}.editor-actions{margin-top:12px}.revision-actions{margin-bottom:10px}.markdown{overflow-wrap:anywhere;line-height:1.6;padding-top:4px}.markdown>:first-child{margin-top:0}.markdown>:last-child{margin-bottom:0}.markdown h2{font-size:26px;line-height:1.2}.markdown h3{font-size:19px;line-height:1.3}.markdown h4{font-size:16px}.markdown code{background:var(--rail);border-radius:4px;padding:2px 4px}.markdown blockquote{border-left:3px solid var(--line-strong);padding-left:12px;margin-inline:0;color:var(--muted)}.markdown-plain{white-space:pre-wrap;overflow-wrap:anywhere;font:inherit;max-height:60vh;overflow:auto}.stead-state{padding:44px 16px;border:1px dashed var(--line-strong);border-radius:8px;text-align:center;color:var(--muted)}.stead-state h2{color:var(--ink)}.stead-state p{font-size:13px}.stead-state__glyph{font-size:21px}.stead-skeleton{display:grid;gap:12px;max-width:540px;margin-inline:auto}.stead-skeleton span{height:16px;border-radius:4px;background:var(--rail)}.stead-visually-hidden{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}.stead-spinner{width:12px;height:12px;flex:none;border:2px solid currentColor;border-right-color:transparent;border-radius:50%;animation:spin 1s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}@media(prefers-reduced-motion:reduce){.stead-spinner{animation:none}}footer{display:flex;justify-content:space-between;gap:12px;padding:12px 24px;border-top:1px solid var(--line);color:var(--muted);font-size:11px}.support{max-width:36rem;margin-top:6px}.support summary{cursor:pointer}.support p{line-height:1.5}.skip-link{position:absolute;left:-9999px}.skip-link:focus{position:relative;left:0;display:block;padding:12px;background:var(--paper)}@media(max-width:1020px){.workspace{grid-template-columns:180px minmax(0,1fr)}.content{padding-inline:22px}.work-view.with-detail{grid-template-columns:minmax(0,1fr)}.work-view .work-detail{grid-row:1}}@media(max-width:730px){.editor-layout{grid-template-columns:minmax(0,1fr)}.editor-preview{border-top:1px solid var(--line);border-left:0}.document-editor textarea{min-height:230px}}@media(max-width:620px){.editor-heading{flex-direction:column;align-items:start;gap:8px}.topbar{min-height:52px;padding-inline:14px}.alpha,.member-name,.space-label,.rail-label,.sidebar-note{display:none}.account,.member-label{min-width:0}.account{gap:8px}.account button{flex:none}.member-label small{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.workspace{display:block}.sidebar{display:flex;align-items:center;gap:6px;padding:7px 12px;border-right:0;border-bottom:1px solid var(--line)}.sidebar nav{display:flex;min-width:0;overflow-x:auto;margin:0;padding:3px}.sidebar nav button{flex:none;max-width:100%}.sidebar>.stead-button{flex:none}.content{padding:19px 14px 28px}.project-heading{align-items:start}.tabs{display:grid;grid-template-columns:1.3fr 1fr 1fr 1fr 1.15fr 1fr 1.1fr;gap:0}.tabs .stead-button{min-width:0;min-height:38px;padding-inline:2px;font-size:11.5px}.toolbar{min-height:56px;padding-block:10px}.view-heading select{max-width:100%}.work-row,.work-view.with-detail .work-row{grid-template-columns:minmax(0,1fr) auto;gap:5px 8px}.work-row .resource-summary{grid-column:1 / -1}.work-row .work-properties,.work-view.with-detail .work-properties{grid-column:1;grid-row:2}.work-row .row-actions,.work-view.with-detail .row-actions{grid-column:2;grid-row:2}.resource-row:not(.work-row){align-items:start;flex-direction:column}.work-group-heading,.work-row{padding-inline:11px}footer{flex-direction:column;gap:8px;padding-inline:14px}.error,.banner,.live:not(:empty){padding-inline:14px}}@media(max-width:360px){.tabs{grid-template-columns:repeat(4,minmax(0,1fr))}}

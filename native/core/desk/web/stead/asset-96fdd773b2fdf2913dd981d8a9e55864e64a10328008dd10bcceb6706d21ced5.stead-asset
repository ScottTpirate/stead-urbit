.stead-icon{display:inline-block;width:16px;height:16px;flex:none;vertical-align:middle}.stead-picker-label{color:var(--muted);margin-inline-end:6px;font-weight:400}.stead-picker-value{overflow-wrap:anywhere}.stead-picker-chevron{margin-inline-start:6px;flex:none}.stead-control-popup{position:fixed;z-index:50;width:min(320px,calc(100vw - 16px));max-height:min(360px,calc(100dvh - 16px));overflow-y:auto;padding:5px;border:1px solid var(--line-strong);border-radius:8px;color:var(--ink);background:var(--paper);box-shadow:0 8px 28px #24201924;font-size:14px}.stead-control-option{display:flex;align-items:center;gap:8px;width:100%;min-height:36px;padding:8px 10px;border:0;border-radius:5px;color:inherit;background:transparent;font:inherit;text-align:start;cursor:pointer}.stead-control-option>span:first-child{min-width:0;overflow-wrap:anywhere}.stead-control-option small{display:block;margin-top:3px;color:var(--muted);font-size:12px}.stead-control-option:enabled:hover,.stead-control-option:focus-visible,.stead-control-option[data-active=true]{background:var(--selected)}.stead-control-option[aria-disabled=true]{opacity:.55;cursor:default}.stead-control-option--danger{color:var(--danger);border-top:1px solid var(--line);border-radius:0 0 5px 5px;margin-top:4px}.stead-control-check{margin-inline-start:auto;flex:none}.stead-control-note{padding:8px 10px;margin:0;color:var(--muted);font-size:13px}.stead-control-note p{margin:0 0 8px}.stead-combobox>input{margin-bottom:5px;font-size:14px}.stead-dialog{width:min(680px,calc(100vw - 32px));max-height:calc(100dvh - 32px);padding:0;overflow:hidden;border:1px solid var(--line-strong);border-radius:12px;color:var(--ink);background:var(--paper);box-shadow:0 24px 64px #201f1d40}.stead-dialog[open]{display:flex;flex-direction:column}.stead-dialog::backdrop{background:#201f1d60}.stead-dialog-header{flex:none;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:20px 24px 12px}.stead-dialog-header h2{margin:0;font-size:20px;overflow-wrap:anywhere}.stead-dialog-description{flex:none;margin:0;padding:0 24px 16px;color:var(--muted);line-height:1.5}.stead-dialog-body{min-height:0;min-width:0;overflow:auto;overscroll-behavior:contain;padding:8px 24px 24px}.stead-dialog-footer{flex:none;display:flex;flex-wrap:wrap;justify-content:end;gap:8px;padding:16px 24px;border-top:1px solid var(--line)}.stead-person{display:inline-flex;align-items:center;gap:6px;min-width:0;max-width:100%;font-size:13px}.stead-person-avatar{display:inline-grid;place-items:center;width:24px;height:24px;flex:none;border-radius:50%;color:var(--ink);background:var(--selected);font-size:10px;font-weight:650}.stead-person-name{min-width:0;overflow-wrap:anywhere}.stead-person-kind,.stead-person-inherited{border:1px solid var(--line-strong);border-radius:4px;padding:2px 4px;font-size:11px;color:var(--muted)}.stead-person-kind{flex:none}.stead-status-badge{display:inline-flex;align-items:center;gap:5px;max-width:100%;padding:3px 7px;border:1px solid var(--line-strong);border-radius:5px;font-size:12px;overflow-wrap:anywhere}.stead-status-badge[data-tone=active]{color:var(--accent)}.stead-status-badge[data-tone=success]{color:var(--success)}.stead-status-badge[data-tone=warning],.stead-status-badge[data-tone=danger]{color:var(--danger)}.stead-outcome{padding:12px 14px;border:1px solid var(--line);border-radius:7px;background:var(--rail);font-size:13px;line-height:1.5;overflow-wrap:anywhere}.stead-outcome p{margin:3px 0 0;color:var(--muted)}.stead-outcome-action{margin-top:8px}.stead-outcome[data-state=conflict],.stead-outcome[data-state=permission_revoked]{border-inline-start:3px solid var(--danger)}@media(pointer:coarse){.stead-control-option,.stead-dialog .stead-button{min-height:44px}}@media(max-width:600px){.stead-dialog{width:100%;max-width:100%;height:100dvh;max-height:100dvh;margin:0;border:0;border-radius:0}.stead-dialog-header{padding:16px}.stead-dialog-description{padding:0 16px 16px}.stead-dialog-body{padding:8px 16px 20px}.stead-dialog-footer{padding:16px}.stead-person{flex-wrap:wrap}}@media(prefers-reduced-motion:reduce){.stead-control-popup,.stead-dialog{scroll-behavior:auto}}.markdown{font-size:1rem;line-height:1.65;max-width:800px;overflow-wrap:anywhere}.markdown h1,.markdown h2,.markdown h3,.markdown h4,.markdown h5,.markdown h6{line-height:1.3;margin:1.4em 0 .6em}.markdown h1{font-size:1.75rem}.markdown h2{font-size:1.5rem}.markdown h3{font-size:1.25rem}.markdown p,.markdown ul,.markdown ol,.markdown blockquote{margin:.7em 0}.markdown ul,.markdown ol{padding-inline-start:1.7em}.markdown li+li{margin-top:.2em}.markdown blockquote{border-inline-start:3px solid var(--border,#dedcd5);padding-inline-start:1em;color:var(--muted,#63665f)}.markdown pre{overflow:auto;max-width:100%;padding:1rem;border-radius:8px;background:var(--background,#f7f7f5);white-space:pre}.markdown code{font-family:ui-monospace,monospace;font-size:.85em}.markdown :not(pre)>code{padding:.1em .3em;background:var(--background,#f7f7f5);border-radius:3px}.markdown-table{overflow:auto;max-width:100%;margin:1rem 0}.markdown table{border-collapse:collapse;width:100%;font-size:.95rem}.markdown th,.markdown td{border:1px solid var(--border,#dedcd5);padding:.5em .7em;text-align:start}.markdown a{color:var(--accent,#5b50bd);text-decoration:underline;text-underline-offset:3px}.markdown input[type=checkbox]{display:inline-block;width:auto;inline-size:1em;block-size:1em;padding:0;margin:0 .5em 0 0;vertical-align:-.1em;accent-color:var(--accent,#5b50bd)}.markdown-attachment{display:inline-block;border:1px solid var(--border,#dedcd5);border-radius:6px;padding:.3em .6em}.markdown .markdown-plain{white-space:pre-wrap}.document-outline{margin-block:0 24px;border:1px solid var(--line);border-radius:8px;background:var(--rail);font-size:14px}.document-outline summary{min-height:44px;padding:10px 14px;cursor:pointer;font-weight:600}.document-outline ol{list-style:none;margin:0;padding:0 10px 10px;max-height:320px;max-height:min(40dvh,320px);overflow-y:auto;overscroll-behavior:contain}.document-outline li{margin:0;padding:0;min-width:0}.document-outline .stead-button{justify-content:flex-start;width:100%;min-height:44px;padding-block:8px;text-align:left;white-space:normal;overflow-wrap:anywhere}.document-outline li[data-level="2"]{padding-left:8px}.document-outline li[data-level="3"],.document-outline li[data-level="4"],.document-outline li[data-level="5"],.document-outline li[data-level="6"]{padding-left:16px}.document-outline p{margin:0;padding:0 14px 12px;color:var(--muted)}.markdown .document-outline-heading{scroll-margin-block-start:80px}@media(max-width:620px){.document-outline{margin-bottom:16px}.document-outline ol{padding-inline:6px}.document-outline li[data-level]{padding-left:0}}

:root{--house-ink: #f6f2eb;--house-muted: #c2bdb4;--house-field: #242422;--house-line: #595650;--house-focus: #c5b8ff;--house-ground: #181817;--house-light: linear-gradient(90deg, rgb(17 17 16 / 86%), transparent 78%), radial-gradient(ellipse 5% 140% at 78% 55%, rgb(227 218 197 / 15%), transparent), radial-gradient(ellipse 7% 110% at 88% 28%, rgb(224 216 199 / 13%), transparent), linear-gradient(101deg, #141413 25%, #2e2d29 68%, #181817 100%)}:root{font:15px/1.55 Inter,ui-sans-serif,system-ui,sans-serif;color:var(--house-ink);min-height:100%;background-color:var(--house-ground);background-image:var(--house-light);color-scheme:dark;--muted: var(--house-muted);--line: var(--house-line);--mono: ui-monospace, SFMono-Regular, Consolas, monospace}*{box-sizing:border-box}body{margin:0}#root{max-width:546px;margin:auto;padding:clamp(28px,8vh,70px) 20px 32px}.identity-header{display:grid;gap:14px}.identity-mark{display:grid;place-items:center;border:1px solid currentColor;border-radius:50%;width:34px;height:34px;font:21px var(--mono)}h1{margin:0;font-size:clamp(27px,5vw,34px);font-weight:650;letter-spacing:-.04em;line-height:1.15}.identity-toolbar{display:flex;flex-wrap:wrap;align-items:center;gap:8px 16px;margin:12px 0 16px}.identity-status{flex:1 1 230px;margin:0;color:var(--muted);font-size:14px}.identity-requests{display:grid;gap:12px}.identity-request{min-width:0;padding:clamp(16px,4vw,22px);border:1px solid var(--line);border-radius:13px;background:var(--house-field);overflow-wrap:anywhere}.identity-caption{margin:0;color:var(--muted);font-size:12px}.identity-code{margin:4px 0 12px;font:650 clamp(24px,5vw,30px)/1.25 var(--mono);letter-spacing:.05em}.identity-address{margin:0 0 5px;font:13px/1.5 var(--mono)}.identity-result{margin:13px 0 0;padding-top:12px;border-top:1px solid var(--line);font-size:13px}.identity-details{margin-top:14px;color:var(--muted);font-size:12px}.identity-details summary{width:fit-content;cursor:pointer}.identity-details p{margin:5px 0 0;font:12px/1.5 var(--mono)}.identity-action{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:8px 12px;border:1px solid transparent;border-radius:9px;font:600 14px/1.35 Inter,ui-sans-serif,system-ui,sans-serif;text-align:center;text-decoration:none;cursor:pointer}.identity-action[hidden]{display:none}.identity-action--quiet{border-color:var(--line);color:var(--house-ink);background:transparent}.identity-action--quiet:hover{background:#373633}.identity-action--primary{width:100%;color:var(--house-ground);background:var(--house-ink)}.identity-request .identity-action--primary{margin-top:12px}.identity-action--primary:hover{background:#dedad2}.identity-action:disabled{opacity:.55;cursor:default}:focus-visible{outline:2px solid var(--house-focus);outline-offset:3px}.identity-settings{margin-top:18px}.identity-settings summary{cursor:pointer;font-weight:600}.identity-settings details[open]>*+*{margin-top:12px}.identity-input{display:block;width:100%;padding:8px 10px;margin-top:4px;background:var(--house-ground);color:var(--house-ink);border:1px solid var(--line);border-radius:7px;font:inherit}.identity-key-list{list-style:none;padding:0}.identity-key-list li{display:flex;align-items:center;justify-content:space-between;gap:12px;padding-block:5px}

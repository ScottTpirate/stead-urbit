::  Trusted disposable controller only. This is not a public product carrier.
::  One batch requests exact activation followed by idle of this Home alone.
::  The supervisor must observe saved10/predecessor; returning is NOT proof.
/-  spider
/+  strandio, stead-codec
=,  strand=strand:spider
^-  thread:spider
|=  arg=vase
=/  [~ target=@p app=@tas mode=@tas route=path raw=@t]
  ;;([~ @p @tas @tas path @t] q.arg)
?>  &(=(~zod target) =(%stead-home app) =(%activate-paused mode) ?=(~ route))
?>  (lte (met 3 raw) 65.536)
=/  m  (strand ,vase)
^-  form:m
;<  =bowl:spider  bind:m  get-bowl:strandio
?>  =(~zod our.bowl)
?>  .^(? %j /(scot %p our.bowl)/fake/(scot %da now.bowl))
;<  ~  bind:m
  %-  send-raw-cards:strandio
  :~  [%pass /activate %agent [our.bowl %stead-home] %poke %stead-product-activate-1 !>(raw)]
      [%pass /pause-home %arvo %g %idle %stead-home]
  ==
(pure:m !>([%stead-core-result (bytes-hex:stead-codec '{}')]))

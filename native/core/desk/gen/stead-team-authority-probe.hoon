/+  stead-team, stead-team-codec, stead-team-config, stead-codec, stead-core, stead-git, stead-projection, stead-views, stead-browser, stead-http, stead-restore
=>
|%
++  id
  |=  n=@ud
  ^-  @t
  (fixture-id:stead-core (cat 3 '000000000' (decimal:stead-codec n)))
++  command
  |=  [req=@ud resource=@ud revision=@ud operation=@t payload=(list [@t @t])]
  ^-  command:stead-codec
  =/  value
    %-  object:stead-codec
    :~  ['protocol' 'stead.command/3']  ['request_id' (id req)]
        ['project_id' (id 100)]  ['resource_id' (id resource)]
        ['expected_revision' (decimal:stead-codec revision)]
        ['authority_epoch' '1']  ['operation' operation]
    ==
  ?>  ?=([%o *] value)
  (decode:stead-team-codec (canonical:stead-codec [%o (~(put by p.value) 'payload' (object:stead-codec payload))]))
++  accepted
  |=  out=transition:stead-team
  ^-  ?
  =/  value  (need (parse-result:stead-codec response.out))
  ?>  ?=([%o *] value)
  =('accepted' (field:stead-codec p.value 'status'))
++  finish-restore
  |=  job=job:stead-restore
  ^-  job:stead-restore
  |-
  ?.  =(%pending status.job)  job
  $(job (step:stead-restore job))
++  restored
  |=  db=state:stead-team
  ^-  job:stead-restore
  (finish-restore (begin:stead-restore db ~zod))
--
:-  %say
|=  *
~&  %stead-team-probe-start
=/  initial  (configure:stead-team empty:stead-team '{"protocol":"stead.team-config/1","expected_revision":"0","home":"~zod","origin":"https://home.test","organization_id":"019939ba-4000-7000-8000-000000000005","team_id":"019939ba-4000-7000-8000-000000000006","custody":"local-disposable","runtime":"isolated-fake","bindings":{"~bus":{"principal_id":"019939ba-4000-7000-8000-000000000102","binding_id":"019939ba-4000-7000-8000-000000000202","binding_revision":"1","active":"yes","expires_at_ms":"9999999","display_name":"Alice"},"~nec":{"principal_id":"019939ba-4000-7000-8000-000000000103","binding_id":"019939ba-4000-7000-8000-000000000203","binding_revision":"1","active":"yes","expires_at_ms":"9999999","display_name":"Zoë"}},"project_creators":{"019939ba-4000-7000-8000-000000000102":"yes"}}' ~zod 1.000)
=/  alice  (need (native-context:stead-team initial ~bus 1.001))
=/  bob  (need (native-context:stead-team initial ~nec 1.001))
?>  ?=(~ (native-context:stead-team initial ~bud 1.001))
=/  create  (command 301 100 0 'project.create' ~[['organization_id' '019939ba-4000-7000-8000-000000000005'] ['owning_team_id' '019939ba-4000-7000-8000-000000000006'] ['title' 'Garden'] ['project_key' 'GARDEN'] ['preset' 'general']])
=/  project  (apply-command:stead-team initial alice create 1.001)
?>  (accepted project)
?>  =(3 (role:stead-team next.project alice (id 100) 1.002))
?>  =(0 (role:stead-team next.project bob (id 100) 1.002))
=/  replay  (apply-command:stead-team next.project alice create 1.002)
?>  =(project replay)
=/  grant  (command 302 100 1 'policy.grant' ~[['grant_id' (id 501)] ['principal_id' principal.identity.bob] ['role' 'contributor'] ['expires_at_ms' '8000000']])
=/  granted  (apply-command:stead-team next.project alice grant 1.003)
?>  (accepted granted)
?>  =(2 (role:stead-team next.granted bob (id 100) 1.004))
=/  work-cmd  (command 303 101 0 'work.create' ~[['title' 'First task'] ['description' 'Native state'] ['type' 'task'] ['status' 'todo'] ['priority' 'none']])
=/  work  (apply-command:stead-team next.granted bob work-cmd 1.004)
?>  (accepted work)
?>  (subject:stead-team next.work alice (id 100) 'work' '' (id 101) 1.005)
=/  private  (apply-command:stead-team next.work alice (command 304 102 0 'container.create' ~[['title' 'My drafts'] ['visibility' 'private']]) 1.005)
?>  (accepted private)
?>  !(box-access:stead-team next.private bob (id 100) (id 102) 1.006)
=/  markdown  (cat 3 (header:stead-team (id 103) 'draft') '# A selected page')
=/  doc-cmd  (command 305 103 0 'document.save' ~[['container_id' (id 102)] ['markdown' markdown]])
=/  denied  (apply-command:stead-team next.private bob doc-cmd 1.006)
?>  !(accepted denied)
?>  =(next.private next.denied)
=/  doc  (apply-command:stead-team next.private alice doc-cmd 1.006)
?>  (accepted doc)
=/  canary-text  (cat 3 (header:stead-team (id 104) 'draft') 'UNSELECTED-PRIVATE-CANARY')
=/  canary  (apply-command:stead-team next.doc alice (command 306 104 0 'document.save' ~[['container_id' (id 102)] ['markdown' canary-text]]) 1.007)
?>  (accepted canary)
=/  shared-cmd  (command 307 105 0 'container.create' ~[['title' 'Team knowledge'] ['visibility' 'shared']])
=/  unauthorized  (apply-command:stead-team next.canary bob shared-cmd 1.008)
?>  !(accepted unauthorized)
?>  =(next.canary next.unauthorized)
=/  shared  (apply-command:stead-team next.canary alice shared-cmd 1.008)
?>  (accepted shared)
=/  source  (~(got by containers.data.next.shared) (id 102))
?>  ?=(^ head.source)
=/  publish-cmd  (command 308 106 0 'document.publish' ~[['source_project_id' (id 100)] ['source_container_id' (id 102)] ['source_document_id' (id 103)] ['source_revision' '1'] ['source_head' (oid-text:stead-git u.head.source)] ['container_id' (id 105)] ['expected_head' '']])
=/  published  (apply-command:stead-team next.shared alice publish-cmd 1.009)
?>  (accepted published)
?>  (subject:stead-team next.published bob (id 100) 'document' (id 105) (id 106) 1.010)
?>  =(source (~(got by containers.data.next.published) (id 102)))
=/  destination  (~(got by containers.data.next.published) (id 105))
?>  ?=(^ head.destination)
=/  hidden  (~(got by documents.data.next.published) [(id 100) (scope-key:stead-core (id 102) (id 104))])
?>  !(~(has in (~(got by reachable.data.next.published) u.head.destination)) blob.hidden)
?>  !(~(has in (~(got by reachable.data.next.published) u.head.destination)) u.head.source)
=/  copied  (~(got by documents.data.next.published) [(id 100) (scope-key:stead-core (id 105) (id 106))])
=/  blob  (~(got by objects.data.next.published) blob.copied)
?>  =((cat 3 (header:stead-team (id 106) 'published') '# A selected page') data.body.blob)
=/  revoke  (command 309 100 2 'policy.revoke' ~[['grant_id' (id 501)]])
=/  revoked  (apply-command:stead-team next.published alice revoke 1.010)
?>  (accepted revoked)
?>  !(subject:stead-team next.revoked bob (id 100) 'work' '' (id 101) 1.011)
=/  old-retry  (apply-command:stead-team next.revoked bob work-cmd 1.011)
?>  !(accepted old-retry)
?>  =(next.revoked next.old-retry)
::  Reviewed regressions: creator receipt recovery requires a current grant.
=/  self-revoke  (apply-command:stead-team next.revoked alice (command 310 100 3 'policy.revoke' ~[['grant_id' (id 301)]]) 1.012)
?>  (accepted self-revoke)
=/  replay-revoked  (apply-command:stead-team next.self-revoke alice create 1.013)
?>  !(accepted replay-revoked)
?>  =(next.self-revoke next.replay-revoked)
::  A relation spanning two private collections invalidates both visible views.
=/  private-two  (apply-command:stead-team next.published alice (command 311 107 0 'container.create' ~[['title' 'Other drafts'] ['visibility' 'private']]) 1.011)
?>  (accepted private-two)
=/  page-two  (apply-command:stead-team next.private-two alice (command 312 108 0 'document.save' ~[['container_id' (id 107)] ['markdown' (cat 3 (header:stead-team (id 108) 'draft') 'Other page')]]) 1.012)
?>  (accepted page-two)
=/  first-generation  (~(got by generations.next.page-two) [(id 100) (id 102)])
=/  second-generation  (~(got by generations.next.page-two) [(id 100) (id 107)])
=/  shared-generation  (~(got by generations.next.page-two) [(id 100) ''])
=/  relation-cmd  (command 313 109 0 'relation.create' ~[['type' 'related_to'] ['source_project_id' (id 100)] ['source_kind' 'document'] ['source_container_id' (id 102)] ['source_id' (id 103)] ['target_project_id' (id 100)] ['target_kind' 'document'] ['target_container_id' (id 107)] ['target_id' (id 108)]])
=/  linked  (apply-command:stead-team next.page-two alice relation-cmd 1.013)
?>  (accepted linked)
?>  =(+(first-generation) (~(got by generations.next.linked) [(id 100) (id 102)]))
?>  =(+(second-generation) (~(got by generations.next.linked) [(id 100) (id 107)]))
?>  =(shared-generation (~(got by generations.next.linked) [(id 100) '']))
?>  !(subject:stead-team next.linked bob (id 100) 'relation' '' (id 109) 1.014)
=/  delete-cmd  (command 314 103 1 'document.delete' ~[['container_id' (id 102)] ['expected_head' (oid-text:stead-git u.head.source)]])
=/  deleted  (apply-command:stead-team next.linked alice delete-cmd 1.014)
?>  (accepted deleted)
?>  !(subject:stead-team next.deleted alice (id 100) 'document' (id 102) (id 103) 1.015)
?>  !(subject:stead-team next.deleted alice (id 100) 'relation' '' (id 109) 1.015)
?>  =((add first-generation 2) (~(got by generations.next.deleted) [(id 100) (id 102)]))
?>  =((add second-generation 2) (~(got by generations.next.deleted) [(id 100) (id 107)]))
?>  =(shared-generation (~(got by generations.next.deleted) [(id 100) '']))
=/  after-delete  (~(got by containers.data.next.deleted) (id 102))
?>  !(~(has by entries.after-delete) (id 103))
?>  (~(has by entries.after-delete) (id 104))
?>  =(deleted (apply-command:stead-team next.deleted alice delete-cmd 1.015))
=/  resurrect  (apply-command:stead-team next.deleted alice doc-cmd 1.015)
?>  !(accepted resurrect)
?>  =(next.deleted next.resurrect)
::  Receipt attribution comes from the verified caller context.
=/  receipt  (need (parse-result:stead-codec response.work))
?>  ?=([%o *] receipt)
?>  =(principal.identity.bob (field:stead-codec p.receipt 'principal_id'))
?>  =('~nec' (field:stead-codec p.receipt 'identity_ship'))
?>  =('native-sender/1' (field:stead-codec p.receipt 'authentication'))
?>  =('' (field:stead-codec p.receipt 'session_audit_id'))
::  Ordinary capacity counts every project, while revocation has its own reserve.
?>  =((lent ~(tap by receipts.data.next.published)) (event-count:stead-team next.published (id 999) |))
?>  =(0 (event-count:stead-team next.published (id 999) &))
::  Accepted-journal projection replay is idempotent and fails closed on gaps.
?>  ?=(^ journal.data.next.published)
=/  building  (begin:stead-projection next.published *state:stead-projection)
?>  !(ready:stead-projection next.published building)
=/  ready  (batch:stead-projection next.published building)
?>  (ready:stead-projection next.published ready)
=/  replayed  (append:stead-projection ready i.journal.data.next.published)
?>  =(ready replayed)
=/  gapped  (append:stead-projection *state:stead-projection i.journal.data.next.published)
?>  poisoned.gapped
?>  ?=(~ entries.visible.gapped)
=/  poison  (append:stead-projection ready i.journal.data.next.published(bytes 'bad'))
?>  poisoned.poison
?>  =(visible.ready visible.poison)
::  Reads resolve the same current authority before revealing any field.
=/  search=query:stead-team-codec  [(id 601) 'search' (id 100) '' '' 'UNSELECTED-PRIVATE-CANARY' '']
=/  alice-search  (execute:stead-views next.published ready *state:stead-views alice search 1.020 41)
=/  bob-search  (execute:stead-views next.published ready *state:stead-views bob search 1.020 42)
?>  (contains:stead-views 'UNSELECTED-PRIVATE-CANARY' response.alice-search)
?>  !(contains:stead-views 'UNSELECTED-PRIVATE-CANARY' response.bob-search)
?>  (contains:stead-views '"rows":{}' response.bob-search)
=/  private-query=query:stead-team-codec  [(id 602) 'document' (id 100) (id 102) (id 103) '' '']
=/  denied-query  (execute:stead-views next.published ready *state:stead-views bob private-query 1.020 43)
?>  =((error:stead-team 'denied_or_not_found') response.denied-query)
=/  shared-query=query:stead-team-codec  [(id 603) 'document' (id 100) (id 105) (id 106) '' '']
=/  shared-read  (execute:stead-views next.published ready *state:stead-views bob shared-query 1.020 44)
?>  (contains:stead-views '# A selected page' response.shared-read)
?>  !(contains:stead-views 'UNSELECTED-PRIVATE-CANARY' response.shared-read)
?>  =((generation:stead-views next.published bob shared-query 1.020) (generation:stead-views next.deleted bob shared-query 1.020))
?>  =('é🙂' (prefix:stead-views 'é🙂more' 2))
::  Pure API orchestration supplies actual browser attribution only after approval.
=/  login=incoming:stead-http  ['/stead/auth/start' '{"protocol":"stead.auth/1","identity_ship":"~bus"}' '' '' '']
=/  start  (call:stead-browser next.published ready *ephemeral:stead-browser login 1.021 101)
?>  =(200 status.start)
?>  ?=(^ outgoing.start)
?>  ?=(^ cookies.start)
=/  pending-parts  (split:stead-http i.cookies.start 59)
?>  ?=(^ pending-parts)
=/  pending-cookie  (need (cookie-pair:stead-http i.pending-parts))
=/  payload  (need (parse-result:stead-codec bytes.start))
?>  ?=([%o *] payload)
=/  challenge  (field:stead-codec p.payload 'challenge_id')
=/  wrong-sender  (mule |.((approve:stead-browser next.published transient.start ~bud bytes.u.outgoing.start 1.022)))
?>  =(%| -.wrong-sender)
=/  approved  (approve:stead-browser next.published transient.start ~bus bytes.u.outgoing.start 1.022)
=/  consume  (canonical:stead-codec (object:stead-codec ~[['protocol' 'stead.auth/1'] ['challenge_id' challenge]]))
=/  logged  (call:stead-browser next.published ready approved ['/stead/auth/consume' consume '' value.pending-cookie ''] 1.023 102)
?>  =(200 status.logged)
?>  ?=(^ cookies.logged)
=/  session-parts  (split:stead-http i.cookies.logged 59)
?>  ?=(^ session-parts)
=/  session-cookie  (need (cookie-pair:stead-http i.session-parts))
=/  authenticated  (need (parse-result:stead-codec bytes.logged))
?>  ?=([%o *] authenticated)
=/  csrf  (field:stead-codec p.authenticated 'csrf')
=/  browser-cmd  (command 390 190 0 'work.create' ~[['title' 'Browser task'] ['description' 'Verified context'] ['type' 'task'] ['status' 'todo'] ['priority' 'none']])
=/  browser-write  (call:stead-browser db.logged view.logged transient.logged ['/stead/api/command' canonical-bytes.browser-cmd value.session-cookie '' csrf] 1.024 103)
=/  receipt  (need (parse-result:stead-codec bytes.browser-write))
?>  ?=([%o *] receipt)
?>  =('accepted' (field:stead-codec p.receipt 'status'))
?>  =('native-approved-browser/1' (field:stead-codec p.receipt 'authentication'))
?>  =('~bus' (field:stead-codec p.receipt 'identity_ship'))
?>  (opaque:stead-team-codec (field:stead-codec p.receipt 'session_audit_id'))
=/  bad-csrf  (call:stead-browser db.browser-write view.browser-write transient.browser-write ['/stead/api/command' canonical-bytes.browser-cmd value.session-cookie '' (hex:stead-codec 64 0)] 1.025 104)
?>  =(403 status.bad-csrf)
?>  =(db.browser-write db.bad-csrf)
?>  (contains:stead-views 'invalid_csrf' bytes.bad-csrf)
=/  resumed  (call:stead-browser db.browser-write view.browser-write transient.browser-write ['/stead/auth/resume' '{"protocol":"stead.auth/1"}' value.session-cookie '' ''] 1.026 105)
?>  =(200 status.resumed)
=/  resumed-value  (need (parse-result:stead-codec bytes.resumed))
?>  ?=([%o *] resumed-value)
=/  new-csrf  (field:stead-codec p.resumed-value 'csrf')
?>  !=(new-csrf csrf)
=/  stale-csrf  (call:stead-browser db.resumed view.resumed transient.resumed ['/stead/api/command' canonical-bytes.browser-cmd value.session-cookie '' csrf] 1.027 106)
?>  =(403 status.stale-csrf)
=/  ended  (call:stead-browser db.resumed view.resumed transient.resumed ['/stead/auth/logout' '{"protocol":"stead.auth/1"}' value.session-cookie '' new-csrf] 1.028 107)
?>  =(200 status.ended)
?>  ?=(~ sessions.auth.transient.ended)
=/  expired  (call:stead-browser db.ended view.ended transient.ended ['/stead/api/command' canonical-bytes.browser-cmd value.session-cookie '' new-csrf] 1.029 108)
?>  =(401 status.expired)
::  Real bounded pagination includes maximum valid escaped work descriptions.
=/  [many=state:stead-team indexed=state:stead-projection]
  =/  db  next.published
  =/  view  ready
  =/  n=@ud  700
  |-
  ?:  =(n 722)  [db view]
  =/  cmd  (command n (add n 100) 0 'work.create' ~[['title' (cat 3 'Task ' (decimal:stead-codec n))] ['description' (fil 3 8.192 92)] ['type' 'task'] ['status' 'todo'] ['priority' 'none']])
  =/  outcome  (apply-command:stead-team db bob cmd 1.030)
  ?>  (accepted outcome)
  ?>  ?=(^ journal.data.next.outcome)
  $(db next.outcome, view (append:stead-projection view i.journal.data.next.outcome), n +(n))
=/  work-query=query:stead-team-codec  [(id 650) 'work' (id 100) '' '' '' '']
=/  first  (execute:stead-views many indexed *state:stead-views bob work-query 1.031 301)
=/  first-json  (need (parse-result:stead-codec response.first))
?>  ?=([%o *] first-json)
=/  first-rows  (~(got by p.first-json) 'rows')
?>  ?=([%o *] first-rows)
?>  =(20 (lent ~(tap by p.first-rows)))
?>  (lth (met 3 response.first) 32.768)
=/  cursor  (field:stead-codec p.first-json 'cursor')
?>  (opaque:stead-team-codec cursor)
=/  second  (execute:stead-views many indexed next.first bob work-query(cursor cursor) 1.032 302)
=/  second-json  (need (parse-result:stead-codec response.second))
?>  ?=([%o *] second-json)
=/  second-rows  (~(got by p.second-json) 'rows')
?>  ?=([%o *] second-rows)
?>  =(3 (lent ~(tap by p.second-rows)))
?>  =('' (field:stead-codec p.second-json 'cursor'))
=/  wrong-actor  (execute:stead-views many indexed next.first alice work-query(cursor cursor) 1.032 303)
?>  =((error:stead-team 'stale_cursor') response.wrong-actor)
?>  =(next.first next.wrong-actor)
=/  altered  (execute:stead-views many indexed next.first bob work-query(cursor (hex:stead-codec 64 0)) 1.032 304)
?>  =((error:stead-team 'stale_cursor') response.altered)
=/  expired-cursor  (execute:stead-views many indexed next.first bob work-query(cursor cursor) 301.031 305)
?>  =((error:stead-team 'stale_cursor') response.expired-cursor)
=/  full  (execute:stead-views many indexed *state:stead-views bob work-query(resource (id 800)) 1.031 306)
=/  full-json  (need (parse-result:stead-codec response.full))
?>  ?=([%o *] full-json)
=/  full-rows  (~(got by p.full-json) 'rows')
?>  ?=([%o *] full-rows)
=/  full-row  (~(got by p.full-rows) '0')
?>  ?=([%o *] full-row)
?>  =(8.192 (met 3 (field:stead-codec p.full-row 'description')))
=/  changed  (apply-command:stead-team many bob (command 730 800 1 'work.delete' ~) 1.032)
?>  (accepted changed)
?>  ?=(^ journal.data.next.changed)
=/  changed-view  (append:stead-projection indexed i.journal.data.next.changed)
=/  stale  (execute:stead-views next.changed changed-view next.first bob work-query(cursor cursor) 1.033 307)
?>  =((error:stead-team 'stale_cursor') response.stale)
=/  fake-head  many(data data.many(journal journal.data.next.changed))
?>  !(ready:stead-projection fake-head indexed)
::  Same journal length cannot make an unrelated projection current.
=/  other-end  (apply-command:stead-team next.shared bob (command 740 840 0 'work.create' ~[['title' 'Different branch'] ['description' ''] ['type' 'task'] ['status' 'todo'] ['priority' 'none']]) 1.009)
?>  (accepted other-end)
?>  =((lent journal.data.next.other-end) (lent journal.data.next.published))
?>  !(ready:stead-projection next.other-end ready)
::  Restore validates attribution and reconstructs every authoritative map.
~&  %stead-restore-browser-start
=/  restored-browser  (restored db.browser-write)
?>  =(%valid status.restored-browser)
?>  =([~ db.browser-write] (result:stead-restore restored-browser))
~&  %stead-restore-browser-finished
=/  first-step  (step:stead-restore (begin:stead-restore many ~zod))
?>  =(%pending status.first-step)
?>  ?=(~ (result:stead-restore first-step))
~&  %stead-restore-many-start
?>  =(%valid status:(finish-restore first-step))
~&  %stead-restore-many-finished
=/  missing-grants  db.browser-write(data data.db.browser-write(grants ~))
?>  =(%invalid status:(restored missing-grants))
~&  %stead-restore-grants-finished
=/  missing-receipts  db.browser-write(data data.db.browser-write(receipts ~))
?>  =(%invalid status:(restored missing-receipts))
=/  changed-object  (~(got by objects.data.db.browser-write) blob.copied)
=/  malformed  db.browser-write(data data.db.browser-write(objects (~(put by objects.data.db.browser-write) blob.copied changed-object(body [1 'x']))))
?>  =(%invalid status:(restored malformed))
=/  config  (need current.registry.db.browser-write)
=/  removed  db.browser-write(registry registry.db.browser-write(current [~ config(members (~(del by members.config) ~bus), creators ~)]))
?>  (validate:stead-team-config registry.removed ~zod)
?>  =(%valid status:(restored removed))
=/  bound  (~(got by members.config) ~bus)
=/  inactive  bound(identity identity.bound(active |, revision 2))
=/  expired-member  db.browser-write(registry registry.db.browser-write(current [~ config(members (~(put by members.config) ~bus inactive))], revisions (~(put by revisions.registry.db.browser-write) principal.identity.alice 2)))
?>  (validate:stead-team-config registry.expired-member ~zod)
?>  =(%valid status:(restored expired-member))
=/  wrong-bound  bound(identity identity.bound(expires +(expires.identity.bound)))
=/  wrong-config  config(members (~(put by members.config) ~bus wrong-bound))
=/  illegal-expiry  db.browser-write(registry registry.db.browser-write(current [~ wrong-config]))
?>  (validate:stead-team-config registry.illegal-expiry ~zod)
?>  =(%invalid status:(restored illegal-expiry))
=/  moved-people  (~(del by members.config) ~bus)
=/  moved-people  (~(put by moved-people) ~bud bound(identity identity.bound(ship ~bud)))
=/  illegal-ship  db.browser-write(registry registry.db.browser-write(current [~ config(members moved-people)]))
?>  (validate:stead-team-config registry.illegal-ship ~zod)
?>  =(%invalid status:(restored illegal-ship))
?>  ?=(^ journal.data.db.browser-write)
=/  duplicate  db.browser-write(data data.db.browser-write(journal [i.journal.data.db.browser-write journal.data.db.browser-write]))
?>  =(%invalid status:(restored duplicate))
=/  too-large-ship  (actor-json:stead-team identity.alice(ship `@p`(bex 128)))
=/  oversized-actor  (mule |.((decode-actor:stead-team too-large-ship)))
?>  =(%| -.oversized-actor)
[%noun %stead-team-authority-basic-pass]

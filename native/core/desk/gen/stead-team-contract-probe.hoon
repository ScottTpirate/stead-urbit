/+  stead-team-config, stead-team-codec, stead-codec
:-  %say
|=  *
=/  initial  (decode:stead-team-config '{"protocol":"stead.team-config/1","expected_revision":"0","home":"~zod","origin":"https://home.test","organization_id":"019939ba-4000-7000-8000-000000000005","team_id":"019939ba-4000-7000-8000-000000000006","custody":"local-disposable","runtime":"isolated-fake","bindings":{"~bus":{"principal_id":"019939ba-4000-7000-8000-000000000102","binding_id":"019939ba-4000-7000-8000-000000000202","binding_revision":"1","active":"yes","expires_at_ms":"9999999","display_name":"Alice"},"~nec":{"principal_id":"019939ba-4000-7000-8000-000000000103","binding_id":"019939ba-4000-7000-8000-000000000203","binding_revision":"1","active":"yes","expires_at_ms":"9999999","display_name":"Zoë"}},"project_creators":{"019939ba-4000-7000-8000-000000000102":"yes"}}' *registry:stead-team-config ~zod 1.000)
?>  ?=(^ current.initial)
?>  =(1 revision.u.current.initial)
?>  =(2 (lent ~(tap by members.u.current.initial)))
?>  ?=(^ (identity:stead-team-config initial ~bus 1.001))
?>  ?=(~ (identity:stead-team-config initial ~bud 1.001))
?>  ?=(~ (identity:stead-team-config initial ~bus 9.999.999))
=/  updated  (decode:stead-team-config '{"protocol":"stead.team-config/1","expected_revision":"1","home":"~zod","origin":"https://home.test","organization_id":"019939ba-4000-7000-8000-000000000005","team_id":"019939ba-4000-7000-8000-000000000006","custody":"local-disposable","runtime":"isolated-fake","bindings":{"~bus":{"principal_id":"019939ba-4000-7000-8000-000000000102","binding_id":"019939ba-4000-7000-8000-000000000202","binding_revision":"2","active":"no","expires_at_ms":"9999999","display_name":"Alice"},"~nec":{"principal_id":"019939ba-4000-7000-8000-000000000103","binding_id":"019939ba-4000-7000-8000-000000000203","binding_revision":"1","active":"yes","expires_at_ms":"9999999","display_name":"Zoë"}},"project_creators":{"019939ba-4000-7000-8000-000000000102":"yes"}}' initial ~zod 1.002)
?>  ?=(^ current.updated)
?>  =(2 revision.u.current.updated)
?>  ?=(~ (identity:stead-team-config updated ~bus 1.003))
?>  ?=(^ (identity:stead-team-config updated ~nec 1.003))
=/  stale  (mule |.((decode:stead-team-config '{"protocol":"stead.team-config/1","expected_revision":"1","home":"~zod","origin":"https://home.test","organization_id":"019939ba-4000-7000-8000-000000000005","team_id":"019939ba-4000-7000-8000-000000000006","custody":"local-disposable","runtime":"isolated-fake","bindings":{"~bus":{"principal_id":"019939ba-4000-7000-8000-000000000102","binding_id":"019939ba-4000-7000-8000-000000000202","binding_revision":"2","active":"no","expires_at_ms":"9999999","display_name":"Alice"},"~nec":{"principal_id":"019939ba-4000-7000-8000-000000000103","binding_id":"019939ba-4000-7000-8000-000000000203","binding_revision":"1","active":"yes","expires_at_ms":"9999999","display_name":"Zoë"}},"project_creators":{"019939ba-4000-7000-8000-000000000102":"yes"}}' updated ~zod 1.003)))
?>  =(%| -.stale)
=/  rebound  (mule |.((decode:stead-team-config '{"protocol":"stead.team-config/1","expected_revision":"2","home":"~zod","origin":"https://home.test","organization_id":"019939ba-4000-7000-8000-000000000005","team_id":"019939ba-4000-7000-8000-000000000006","custody":"local-disposable","runtime":"isolated-fake","bindings":{"~bus":{"principal_id":"019939ba-4000-7000-8000-000000000102","binding_id":"019939ba-4000-7000-8000-000000000202","binding_revision":"1","active":"yes","expires_at_ms":"9999999","display_name":"Alice"},"~nec":{"principal_id":"019939ba-4000-7000-8000-000000000103","binding_id":"019939ba-4000-7000-8000-000000000203","binding_revision":"1","active":"yes","expires_at_ms":"9999999","display_name":"Zoë"}},"project_creators":{"019939ba-4000-7000-8000-000000000102":"yes"}}' updated ~zod 1.003)))
?>  =(%| -.rebound)
=/  wrong-home  (mule |.((decode:stead-team-config '{"protocol":"stead.team-config/1","expected_revision":"0","home":"~zod","origin":"https://home.test","organization_id":"019939ba-4000-7000-8000-000000000005","team_id":"019939ba-4000-7000-8000-000000000006","custody":"local-disposable","runtime":"isolated-fake","bindings":{"~bus":{"principal_id":"019939ba-4000-7000-8000-000000000102","binding_id":"019939ba-4000-7000-8000-000000000202","binding_revision":"1","active":"yes","expires_at_ms":"9999999","display_name":"Alice"},"~nec":{"principal_id":"019939ba-4000-7000-8000-000000000103","binding_id":"019939ba-4000-7000-8000-000000000203","binding_revision":"1","active":"yes","expires_at_ms":"9999999","display_name":"Zoë"}},"project_creators":{"019939ba-4000-7000-8000-000000000102":"yes"}}' *registry:stead-team-config ~bus 1.000)))
?>  =(%| -.wrong-home)
=/  cmd  (decode:stead-team-codec '{"protocol":"stead.command/3","request_id":"019939ba-4000-7000-8000-000000000301","project_id":"019939ba-4000-7000-8000-000000000001","resource_id":"019939ba-4000-7000-8000-000000000001","expected_revision":"0","authority_epoch":"1","operation":"project.create","payload":{"organization_id":"019939ba-4000-7000-8000-000000000005","owning_team_id":"019939ba-4000-7000-8000-000000000006","title":"Garden","project_key":"GARDEN","preset":"general"}}')
?>  =('stead.command/3' protocol.cmd)
?>  =('project.create' operation.cmd)
?>  =((hash:stead-codec 'stead.command/3' canonical-bytes.cmd) digest.cmd)
=/  old  (mule |.((decode:stead-codec '{"protocol":"stead.command/3","request_id":"019939ba-4000-7000-8000-000000000301","project_id":"019939ba-4000-7000-8000-000000000001","resource_id":"019939ba-4000-7000-8000-000000000001","expected_revision":"0","authority_epoch":"1","operation":"project.create","payload":{"organization_id":"019939ba-4000-7000-8000-000000000005","owning_team_id":"019939ba-4000-7000-8000-000000000006","title":"Garden","project_key":"GARDEN","preset":"general"}}')))
?>  =(%| -.old)
=/  query  (decode-query:stead-team-codec '{"protocol":"stead.query/3","request_id":"019939ba-4000-7000-8000-000000000401","kind":"projects","project_id":"","container_id":"","resource_id":"","search":"","cursor":""}')
?>  =('projects' kind.query)
?>  =('' project.query)
?>  (opaque:stead-team-codec (hex:stead-codec 64 1))
?>  !(opaque:stead-team-codec 'wrong')
?>  =('document' (kind:stead-team-codec 'document.publish'))
?>  =('container' (kind:stead-team-codec 'container.create'))
?>  (validate:stead-team-config initial ~zod)
=/  invalid-history  (mule |.((validate:stead-team-config initial(revisions ~) ~zod)))
?>  =(%| -.invalid-history)
=/  invalid-owner  (mule |.((validate:stead-team-config initial(owners ~) ~zod)))
?>  =(%| -.invalid-owner)
=/  wrong-current-home  (mule |.((validate:stead-team-config initial ~bus)))
?>  =(%| -.wrong-current-home)
=/  removed  (decode:stead-team-config '{"protocol":"stead.team-config/1","expected_revision":"1","home":"~zod","origin":"https://home.test","organization_id":"019939ba-4000-7000-8000-000000000005","team_id":"019939ba-4000-7000-8000-000000000006","custody":"local-disposable","runtime":"isolated-fake","bindings":{"~nec":{"principal_id":"019939ba-4000-7000-8000-000000000103","binding_id":"019939ba-4000-7000-8000-000000000203","binding_revision":"1","active":"yes","expires_at_ms":"9999999","display_name":"Zoë"}},"project_creators":{}}' initial ~zod 1.004)

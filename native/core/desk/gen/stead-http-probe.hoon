/+  stead-http, stead-session
:-  %say
|=  *
=/  origin  'https://home.localhost:8443'
=/  token  (token:stead-session 1 1 'test')
=/  heads=(list [@t @t])
  ~[['Host' 'home.localhost:8443'] ['Origin' origin] ['Content-Type' 'application/json']]
=/  request=inbound-request:eyre
  [| & *address:eyre [%'POST' '/stead/api/query' heads `[2 '{}']]]
?>  ?=(^ (validate:stead-http request origin ~))
?>  ?=(~ (validate:stead-http request(secure |) origin ~))
?>  ?=(~ (validate:stead-http request(authenticated &, secure |) origin ~))
?>  ?=(~ (validate:stead-http request(header-list.request [['Forwarded' 'proto=https'] heads]) origin ~))
?>  ?=(~ (validate:stead-http request(header-list.request [['X-FoRwArDeD-Proto' 'https'] heads]) origin ~))
?>  ?=(~ (validate:stead-http request(header-list.request [['host' 'evil.test'] heads]) origin ~))
?>  ?=(~ (validate:stead-http request 'https://evil.test' ~))
?>  ?=(~ (validate:stead-http request(method.request %'PUT') origin ~))
?>  ?=(~ (validate:stead-http request(url.request '/~/channel/123') origin ~))
?>  ?=(~ (validate:stead-http request(url.request '/stead/api/query?actor=alice') origin ~))
?>  ?=(~ (validate:stead-http request(body.request ~) origin ~))
?>  ?=(~ (validate:stead-http request(body.request `[3 '{}']) origin ~))
?>  ?=(~ (validate:stead-http request(body.request `[65.537 (fil 3 65.537 97)]) origin ~))
=/  credentials  [['Cookie' (cat 3 '__Host-stead-session=' token)] [['X-Stead-CSRF' token] heads]]
=/  allowed  (validate:stead-http request(header-list.request credentials) origin ~)
?>  ?=(^ allowed)
?>  =(token session.u.allowed)
?>  =(token csrf.u.allowed)
?>  ?=(~ (cookies:stead-http (rap 3 ~['__Host-stead-session=' token '; __Host-stead-session=' token])))
?>  ?=(~ (cookies:stead-http '__Host-stead-session=short'))
?>  ?=(~ (cookies:stead-http 'missing-equals'))
?>  ?=(~ (headers:stead-http (reap 33 ['x' 'x'])))
?>  ?=(~ (headers:stead-http ~[['x' (fil 3 8.192 97)]]))
?>  ?=(~ (headers:stead-http ~[['host' 'good\0abad']]))
?>  ?=(~ (validate:stead-http request(header-list.request [['Cookie' 'x=one'] [['Cookie' 'x=two'] heads]]) origin ~))
=/  get  request(method.request %'GET', url.request '/stead/', body.request ~)
?>  ?=(^ (validate:stead-http get origin ~))
?>  ?=(~ (validate:stead-http get(url.request '/~/scry/stead-home/state.json') origin ~))
?>  ?=(~ (validate:stead-http get(url.request '/stead/unknown.js') origin ~))
?>  ?=(^ (validate:stead-http get(url.request '/stead/app.js') origin (silt ~['/stead/app.js'])))
?>  =('__Host-stead-session=; Secure; HttpOnly; SameSite=Strict; Path=/; Max-Age=0' (cookie:stead-http | '' &))
?>  ?=(^ (headers:stead-http (turn (gulf 0 31) |=(n=@ud [(scot %ud n) 'x']))))
?>  ?=(~ (headers:stead-http (turn (gulf 0 32) |=(n=@ud [(scot %ud n) 'x']))))
?>  ?=(^ (headers:stead-http ~[['x' (fil 3 8.191 97)]]))
?>  ?=(~ (headers:stead-http ~[[(fil 3 8.193 97) '']]))
?>  ?=(~ (headers:stead-http ~[['Origin' origin] ['origin' origin]]))
?>  ?=(~ (headers:stead-http ~[['Content-Type' 'application/json'] ['content-type' 'application/json']]))
?>  ?=(~ (headers:stead-http ~[['X-Stead-CSRF' token] ['x-stead-csrf' token]]))
?>  ?=(~ (cookies:stead-http 'bad,name=x'))
?>  ?=(~ (cookies:stead-http 'x="unterminated'))
?>  ?=(~ (cookies:stead-http 'x=has space'))
?>  ?=(^ (cookies:stead-http 'x=YQ=='))
?>  ?=(~ (cookies:stead-http 'x=one; x=two'))
?>  ?=(~ (validate:stead-http get(header-list.request [['Cookie' '__Host-stead-session=bad'] heads]) origin ~))
?>  ?=(~ (validate:stead-http get(body.request `[0 1]) origin ~))
?>  ?=(~ (validate:stead-http request(header-list.request ~[['Host' 'home.localhost:8443'] ['Content-Type' 'application/json']]) origin ~))
?>  ?=(~ (validate:stead-http request(header-list.request ~[['Host' 'home.localhost:8443'] ['Origin' 'null'] ['Content-Type' 'application/json']]) origin ~))
?>  ?=(~ (validate:stead-http request(header-list.request ~[['Host' 'home.localhost:8443'] ['Origin' 'https://evil.test'] ['Content-Type' 'application/json']]) origin ~))
?>  ?=(~ (validate:stead-http request(header-list.request [['X-Stead-CSRF' 'short'] heads]) origin ~))
?>  ?=(~ (validate:stead-http request(header-list.request [['X-Forwarded-Host' 'home.localhost:8443'] heads]) origin ~))
?>  ?=(~ (validate:stead-http request(url.request '/stead/api/%71uery') origin ~))
?>  ?=(~ (validate:stead-http request(url.request (fil 3 513 97)) origin ~))
[%noun %stead-http-49-controls-pass]

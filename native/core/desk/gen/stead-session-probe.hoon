/+  stead-session
:-  %say
|=  *
=/  alice=actor:stead-session
  [~bus '019939ba-4000-7000-8000-000000000102' '019939ba-4000-7000-8000-000000000202' 1 & 9.999.999]
=/  bob=actor:stead-session
  [~nec '019939ba-4000-7000-8000-000000000103' '019939ba-4000-7000-8000-000000000203' 1 & 9.999.999]
=/  origin  'https://home.test'
=/  initial=state:stead-session  *state:stead-session
=/  first  (begin:stead-session initial alice ~zod origin 1.000 0x1234)
?>  =(%pending status.first)
?>  !=(id.first cookie.first)
?>  =(%denied status:(begin:stead-session initial alice ~zod 'http://home.test' 1.000 1))
=/  wrong  (approve:stead-session next.first id.first ~nec alice ~zod origin 'stead.auth/1' 'member-session' 121.000 1.001)
?>  =(%denied status.wrong)
?>  =(next.first next.wrong)
=/  approved  (approve:stead-session next.first id.first ~bus alice ~zod origin 'stead.auth/1' 'member-session' 121.000 1.001)
?>  =(%approved status.approved)
?>  =(%denied status:(approve:stead-session next.approved id.first ~bus alice ~zod origin 'stead.auth/1' 'member-session' 121.000 1.002))
?>  =(%denied status:(consume:stead-session next.approved id.first 'stolen-id-only' alice ~zod origin 1.002 2))
?>  =(%denied status:(consume:stead-session next.approved id.first cookie.first bob ~zod origin 1.002 2))
=/  logged  (consume:stead-session next.approved id.first cookie.first alice ~zod origin 1.002 2)
?>  =(%accepted status.logged)
?>  !=(cookie.logged cookie.first)
?>  =(%denied status:(consume:stead-session next.logged id.first cookie.first alice ~zod origin 1.003 2))
?>  ?=(^ (authorize:stead-session next.logged cookie.logged csrf.logged alice ~zod origin 1.003))
?>  ?=(~ (authorize:stead-session next.logged cookie.logged 'wrong-csrf' alice ~zod origin 1.003))
?>  ?=(~ (authorize:stead-session next.logged cookie.logged csrf.logged bob ~zod origin 1.003))
?>  ?=(~ (authorize:stead-session next.logged cookie.logged csrf.logged alice(revision 2) ~zod origin 1.003))
?>  ?=(~ (authorize:stead-session next.logged cookie.logged csrf.logged alice(active |) ~zod origin 1.003))
?>  ?=(~ (authorize:stead-session next.logged cookie.logged csrf.logged alice ~zod 'https://other.test' 1.003))
?>  ?=(~ (authorize:stead-session next.logged cookie.logged csrf.logged alice ~bus origin 1.003))
?>  ?=(~ (authorize:stead-session next.logged cookie.logged csrf.logged alice ~zod origin 1.801.002))
=/  ended  (logout:stead-session next.logged cookie.logged csrf.logged alice ~zod origin 1.004)
?>  =(%logged-out status.ended)
?>  ?=(~ (authorize:stead-session next.ended cookie.logged csrf.logged alice ~zod origin 1.005))
?>  ?=(~ (authorize:stead-session initial cookie.logged csrf.logged alice ~zod origin 1.005))
?>  (origin-valid:stead-session 'https://home.localhost:8443')
?>  !(origin-valid:stead-session 'https://home..test')
?>  !(origin-valid:stead-session 'https://home.test:0')
?>  !(origin-valid:stead-session 'https://home.test:65536')
?>  !(origin-valid:stead-session 'https://-home.test')
?>  !(origin-valid:stead-session 'https://home.test/')
?>  !(origin-valid:stead-session 'https://home.test:443:80')
?>  !(origin-valid:stead-session 'https://Home.test')
?>  !(origin-valid:stead-session 'https://home.test:0443')
?>  ?=(~ (authorize:stead-session next.logged cookie.logged csrf.logged alice(binding binding.bob) ~zod origin 1.003))
?>  =(%denied status:(approve:stead-session next.first id.first ~bus alice ~zod origin 'stead.auth/1' 'member-session' 121.001 1.001))
=/  challenge  (~(got by challenges.next.approved) id.first)
=/  pending-logout  next.logged(challenges (~(put by challenges.next.logged) id.first challenge))
=/  cleanup  (logout:stead-session pending-logout cookie.logged csrf.logged alice ~zod origin 1.004)
?>  =(~ challenges.next.cleanup)
?>  =(~ sessions.next.cleanup)
=/  rebound  (invalidate-actor:stead-session pending-logout principal.alice)
?>  =(~ challenges.rebound)
?>  =(~ sessions.rebound)
=/  saturated  next.approved(counter 18.446.744.073.709.551.615)
=/  capped  (consume:stead-session saturated id.first cookie.first alice ~zod origin 1.002 2)
?>  =(%capacity status.capped)
?>  =(saturated next.capped)
?>  =(%denied status:(approve:stead-session next.first id.first ~bus alice ~zod origin 'stead.auth/2' 'member-session' 121.000 1.001))
?>  =(%denied status:(approve:stead-session next.first id.first ~bus alice ~zod origin 'stead.auth/1' 'owner-session' 121.000 1.001))
?>  =(%denied status:(approve:stead-session next.first id.first ~bus alice ~zod origin 'stead.auth/1' 'member-session' 121.000 121.000))
?>  =(%denied status:(begin:stead-session initial alice ~bus origin 1.000 1))
=/  live-full  pending-logout(counter 18.446.744.073.709.551.615)
=/  retained  (consume:stead-session live-full id.first cookie.first alice ~zod origin 1.002 2)
?>  =(%capacity status.retained)
?>  =(live-full next.retained)
?>  ?=(^ (authorize:stead-session next.retained cookie.logged csrf.logged alice ~zod origin 1.003))
=/  failed-replace  (replace:stead-session live-full cookie.logged csrf.logged alice bob ~zod origin 1.003 3)
?>  =(%capacity status.failed-replace)
?>  =(live-full next.failed-replace)
?>  ?=(^ (authorize:stead-session next.failed-replace cookie.logged csrf.logged alice ~zod origin 1.004))
=/  replaced  (replace:stead-session pending-logout cookie.logged csrf.logged alice bob ~zod origin 1.003 3)
?>  =(%pending status.replaced)
?>  ?=(~ (authorize:stead-session next.replaced cookie.logged csrf.logged alice ~zod origin 1.004))
?>  !(~(has by challenges.next.replaced) id.first)
?>  =(%denied status:(replace:stead-session pending-logout cookie.logged 'wrong' alice bob ~zod origin 1.003 3))
=/  second  (begin:stead-session next.logged bob ~zod origin 2.000 99)
=/  approved-bob  (approve:stead-session next.second id.second ~nec bob ~zod origin 'stead.auth/1' 'member-session' 122.000 2.001)
=/  logged-bob  (consume:stead-session next.approved-bob id.second cookie.second bob ~zod origin 2.002 100)
?>  =(%accepted status.logged-bob)
=/  replaced-alice  (replace:stead-session next.logged-bob cookie.logged csrf.logged alice alice ~zod origin 2.003 101)
?>  =(%pending status.replaced-alice)
?>  ?=(^ (authorize:stead-session next.replaced-alice cookie.logged-bob csrf.logged-bob bob ~zod origin 2.004))
[%noun %stead-session-57-controls-pass]

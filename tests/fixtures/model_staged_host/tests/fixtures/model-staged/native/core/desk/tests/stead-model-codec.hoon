::  PRIVATE authored cases only; no native execution or effect authority.
::  Hex cords are exact immutable canonical fixture bytes, not opaque handles.
/+  *test, stead-codec, stead-run-state, stead-model-material, stead-model-codec
=,  stead-codec
=>
|%
++  reserve-wire
  ^-  @t
  
++  response-wire
  ^-  @t
  
++  absent-wire
  ^-  @t
  
++  empty-wire
  ^-  @t
  
++  unicode-wire
  ^-  @t
  
++  parsed
  |=  raw=@t
  ^-  json
  (need (parse-result raw))
++  put
  |=  [value=json key=@t next=json]
  ^-  json
  ?>  ?=([%o *] value)
  [%o (~(put by p.value) key next)]
++  field-of
  |=  [value=json key=@t]
  ^-  @t
  ?>  ?=([%o *] value)
  (field p.value key)
++  refused
  |=  raw=@t
  ^-  ?
  ?=([%| *] (mule |.((decode:stead-model-codec raw))))
++  invalid-json
  |=  raw=@t
  ^-  ?
  ?=([%| *] (mule |.((parsed:stead-model-material raw 65.536))))
++  invalid-connection
  |=  raw=@t
  ^-  ?
  ?=([%| *] (mule |.((connection-of:stead-model-material raw))))
++  invalid-context-target
  |=  [key=@t value=@t]
  ^-  ?
  =/  parent  (parsed reserve-wire)
  =/  material  (parsed (field-of parent 'materialization'))
  =/  context  (parsed (field-of material 'current_context_bytes'))
  =/  documents  (parsed (field-of context 'documents'))
  =/  rows  (obj:stead-model-material documents)
  =/  outcome  '019939ba-4000-7000-8000-00000000000a'
  =/  document  (~(got by rows) outcome)
  =/  target  (put (parsed (field-of document 'target')) key [%s value])
  =/  changed-document  (put document 'target' [%s (canonical target)])
  =/  changed-context
    (canonical (put context 'documents' [%s (canonical (put documents outcome changed-document))]))
  =/  scope
    (obj:stead-model-material (put (parsed (field-of material 'scope')) 'context_digest' [%s (hash 'stead.run-context/1' changed-context)]))
  ?=  [%| *]
  %-  mule
  |.  (context-of:stead-model-material changed-context scope (field-of material 'instruction_bytes') (field scope 'runtime_policy_digest'))
++  material-edit
  |=  [key=@t value=@t]
  ^-  @t
  =/  parent  (parsed reserve-wire)
  =/  material  (parsed (field-of parent 'materialization'))
  (canonical (put parent 'materialization' [%s (canonical (put material key [%s value]))]))
--
|%
++  test-model-codec-golden-reserve-and-derived-native-identity
  =/  cmd  (decode:stead-model-codec reserve-wire)
  ?>  ?=(%reserve -.operation.cmd)
  =/  material  material.operation.cmd
  =/  documents  (obj:stead-model-material (parsed (field-of (parsed context.material) 'documents')))
  =/  outcome  '019939ba-4000-7000-8000-00000000000a'
  =/  document  (~(got by documents) outcome)
  =/  target  (parsed (field-of document 'target'))
  %-  expect
  !>  ?&  =('8454d3401416033342316292b220e325b1875d1f204095b4e3eaf7a48365f507' digest.cmd)
          =('818437c5cd173b9f2437f5386ceb63edfa0b52ea8ea285d2b0b269613ccf8118' digest.connection.material)
          =('a77a3190736ca6f233eb3eb1b648728c2c8772f02fd5c7ac81d72cb2b43a3edb' request-digest.intent.material)
          =(1.876 (met 3 request.material))
          =('019939ba-4000-7d20-a047-930c0a8a5a56' effect.cmd)
          =('019939ba-4000-7884-aebc-70dfb39d8389' (derived-request:stead-model-codec cmd 'cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc'))
          =(reserve-wire canonical-bytes.cmd)
          =('019939ba-4000-7000-8000-000000000008' (field-of target 'document_id'))
          !=(outcome (field-of target 'document_id'))
      ==
++  test-model-codec-closed-parent-and-canonical-cas
  =/  parent  (parsed reserve-wire)
  %-  expect
  !>  ?&  (refused (canonical (put parent 'actor' [%s 'owner'])))
          (refused (canonical (put parent 'authorized' [%s 'yes'])))
          (refused (canonical (put parent 'operation' [%s 'dispatch'])))
          (refused (canonical (put parent 'protocol' [%s 'stead.model-effect-command/2'])))
          (refused (canonical (put parent 'attempt' [%s '0'])))
          (refused (canonical (put parent 'attempt' [%s '4'])))
          (refused (canonical (put parent 'expected_run_revision' [%s '01'])))
          (refused (canonical (put parent 'expected_run_revision' [%s '18446744073709551616'])))
          (refused (canonical (put parent 'materialization' (object ~[['caller' 'permission']]))))
          (refused (cat 3 ' ' reserve-wire))
      ==
++  test-model-codec-material-pins-and-exact-charge-reject-drift
  =/  parent  (parsed reserve-wire)
  =/  material  (parsed (field-of parent 'materialization'))
  =/  intent  (parsed (field-of material 'native_intent'))
  =/  charge  (parsed (field-of intent 'charge'))
  =/  smaller  (put intent 'charge' [%s (canonical (put charge 'cost_units' [%s '0']))])
  =/  scope  (parsed (field-of material 'scope'))
  =/  connection  (parsed (field-of material 'connection'))
  %-  expect
  !>  ?&  (refused (material-edit 'native_intent' (canonical smaller)))
          (refused (material-edit 'request_body' '{}'))
          (refused (material-edit 'instruction_bytes' 'Changed agent instructions'))
          (refused (material-edit 'scope' (canonical (put scope 'attempt' [%s '2']))))
          (refused (material-edit 'scope' (canonical (put scope 'runtime_policy_digest' [%s (hex 64 0)]))))
          (refused (material-edit 'connection' (cat 3 ' ' (field-of material 'connection'))))
          (refused (material-edit 'tool_registry' '[]'))
          (invalid-connection (canonical (put connection 'adapter' [%s 'openai.chat-completions/1'])))
          (invalid-connection (canonical (put connection 'authorized' [%s 'yes'])))
          (invalid-context-target 'base_markdown_sha256' (hex 64 0))
          (invalid-context-target 'expected_revision' '0')
          (refused (canonical (put parent 'effect_id' [%s '019939ba-4000-7000-8000-000000000099'])))
      ==
++  test-model-codec-observation-absence-empty-and-binary-bytes
  =/  absent  (decode:stead-model-codec absent-wire)
  =/  empty  (decode:stead-model-codec empty-wire)
  =/  response  (decode:stead-model-codec response-wire)
  ?>  ?=(%observe -.operation.absent)
  ?>  ?=(%observe -.operation.empty)
  ?>  ?=(%observe -.operation.response)
  =/  raw  (raw-response:stead-model-codec '00ff0000')
  =/  bad  (parsed (field-of (parsed empty-wire) 'observation'))
  %-  expect
  !>  ?&  !present.item.operation.absent  present.item.operation.empty
          =(0 length.response.item.operation.absent)
          =(0 length.response.item.operation.empty)
          =('' digest.item.operation.absent)
          =('e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855' digest.item.operation.empty)
          =(4 length.raw)  =(0xff00 data.raw)
          =('e890f350f4385cfe5b486628906ccb2370663d40763f50d39c272d49b3d583a6' (sha256:stead-model-material raw))
          =('001656fe3ab6f9b63c3a962b8242ddd055a6eccb1ff1c9a5b9d3eaf6fc2cd98a' digest.item.operation.response)
          (refused (canonical (put (parsed empty-wire) 'observation' [%s (canonical (put bad 'response_sha256' [%s '']))])))
          (refused (canonical (put (parsed empty-wire) 'observation' [%s (canonical (put bad 'response_hex' [%s 'FF']))])))
          (refused (canonical (put (parsed empty-wire) 'observation' [%s (canonical (put bad 'response_hex' [%s '0']))])))
      ==
++  test-model-codec-parser-and-parent-bounds-do-not-expand
  =/  pairs=(list [@t @t])
    (turn (gulf 1 17) |=(n=@ud [(decimal n) 'value']))
  =/  observation
    (object ~[['disposition' 'response'] ['reason' ''] ['response_hex' (fil 3 65.536 'a')] ['response_sha256' (sha256:stead-model-material [32.768 (fil 3 32.768 170)])]])
  =/  large  (canonical (put (parsed response-wire) 'observation' [%s (canonical observation)]))
  %-  expect
  !>  ?&  (invalid-json '{"a":"one","a":"two"}')
          (invalid-json (canonical (object pairs)))
          (invalid-json '[[[[[[[[["x"]]]]]]]]]')
          (invalid-json '[1.5]')  (invalid-json '[-1]')
          (invalid-json '[9007199254740992]')
          (gth (met 3 large) 65.536)  (refused large)
          (refused (cat 3 reserve-wire (fil 3 65.536 ' ')))
      ==
++  test-model-codec-real-linefeeds-and-supplementary-unicode
  =/  cmd  (decode:stead-model-codec unicode-wire)
  ?>  ?=(%reserve -.operation.cmd)
  =/  material  material.operation.cmd
  %-  expect
  !>  ?&  =('45526080fe8d21a82491ccb4e62f31371bf18d877a18ebae6b457faa38ddf81b' digest.cmd)
          =('0ea8b9d8aa640c2830409da669c1a20c6d2816276dee8781741245234af92fa7' (field scope.material 'context_digest'))
          =('12f52f674e0d3e15b81b18a5966d48b0383d19214a46f116704d7d6263697476' request-digest.intent.material)
          =(1797 (met 3 request.material))
          =(effect.cmd id.intent.material)
      ==
--

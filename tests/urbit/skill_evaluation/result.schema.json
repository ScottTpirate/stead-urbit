{
  "title": "URB-170 observed evaluation record, not a passing-result template",
  "type": "object",
  "required": ["protocol", "status", "package_sha256", "prequalification_artifacts", "conditions", "independent_review", "limits"],
  "properties": {
    "protocol": {"const": "stead.skill-evaluation-result/1"},
    "status": {"enum": ["not_run", "incomplete", "invalid", "completed"]},
    "package_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "prequalification_artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "conditions": {"type": "array", "items": {"$ref": "#/$defs/condition"}},
    "independent_review": {"type": ["object", "null"]},
    "limits": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["path", "sha256", "classification"],
      "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "classification": {"type": "string"}}
    },
    "condition": {
      "type": "object",
      "required": ["condition", "context_id", "model", "settings", "input_files_sha256", "skill_files_sha256", "context_contamination", "active_seconds", "infrastructure_seconds", "tasks"],
      "properties": {
        "condition": {"enum": ["baseline", "local_skill_assisted"]},
        "context_id": {"type": "string"},
        "model": {"type": ["string", "null"]},
        "settings": {"type": "object"},
        "input_files_sha256": {"type": "object"},
        "skill_files_sha256": {"type": "object"},
        "context_contamination": {"type": "array", "items": {"type": "string"}},
        "active_seconds": {"type": "number", "minimum": 0},
        "infrastructure_seconds": {"type": "number", "minimum": 0},
        "tasks": {"type": "array", "items": {"$ref": "#/$defs/task"}}
      }
    },
    "task": {
      "type": "object",
      "required": ["id", "status", "attempts", "candidate_files_sha256", "bindings", "classification", "compile_outcome", "runtime_outcome", "expected_cases", "observed_cases", "assertions", "artifacts"],
      "properties": {
        "id": {"enum": ["T01", "T02", "T03", "T04", "T05", "T06"]},
        "status": {"enum": ["not_run", "refused", "interrupted", "invalid", "failed", "passed"]},
        "attempts": {"type": "array", "items": {"type": "object", "required": ["number", "candidate_files_sha256", "public_feedback_artifacts", "observed_outcome"]}},
        "candidate_files_sha256": {"type": "object"},
        "bindings": {"type": "object", "required": ["source_commit", "runtime_lock_sha256", "installed_clay_tree_sha256", "loaded_closure_sha256", "oracle_sha256", "evaluator_sha256", "guard_report_sha256"]},
        "classification": {"type": "string"},
        "compile_outcome": {"enum": ["not_run", "failed", "passed", "invalid"]},
        "runtime_outcome": {"enum": ["not_run", "failed", "passed", "invalid"]},
        "expected_cases": {"type": "array", "items": {"type": "string"}},
        "observed_cases": {"type": "array", "items": {"type": "string"}},
        "assertions": {"type": "array", "items": {"type": "object", "required": ["id", "status", "actual", "expected", "artifact"]}},
        "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}}
      }
    }
  },
  "description": "Shape only. A schema validator cannot establish passing behavior, complete inventories, equal conditions, truthful native execution, current source binding or independent acceptance. Missing execution remains incomplete."
}

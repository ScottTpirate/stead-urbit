::  PRIVATE six authored cases. No compiler/runtime/model qualification.
/+  *test, stead-codec, stead-model-material, stead-model-codec, stead-model-reply
=,  stead-codec
=>
|%
++  reserve-wire
  ^-  @t
  
++  reply-wire
  ^-  @t
  
++  unicode-wire
  ^-  @t
  
++  material
  ^-  material:stead-model-material
  =/  cmd  (decode:stead-model-codec reserve-wire)
  ?>  ?=(%reserve -.operation.cmd)
  material.operation.cmd
++  original
  ^-  json
  (need (rush reply-wire json-rule:stead-model-material))
++  put
  |=  [value=json key=@t next=json]
  ^-  json
  =/  rows  (obj:stead-model-material value)
  [%o (~(put by rows) key next)]
++  get
  |=  [value=json key=@t]
  ^-  json
  (~(got by (obj:stead-model-material value)) key)
++  emit
  ::  Fixture writer preserves numeric token spellings intentionally so invalid
  ::  and out-of-profile decimals reach the actual production parser/validator.
  |=  value=json
  ^-  @t
  ?~  value  'null'
  ?-  -.value
    %s  (quote p.value)
    %b  ?:(p.value 'true' 'false')
    %n  p.value
    %a  (cat 3 '[' (cat 3 (joined:stead-model-material (turn p.value emit)) ']'))
    %o
      =/  pairs=(list [@t json])
        (sort ~(tap by p.value) |=([a=[@t json] b=[@t json]] (aor -.a -.b)))
      =/  parts=(list @t)
        (turn pairs |=([key=@t val=json] (cat 3 (quote key) (cat 3 ':' (emit val)))))
      (cat 3 '{' (cat 3 (joined:stead-model-material parts) '}'))
  ==
++  choice
  |=  value=json
  ^-  json
  =/  rows  (list-of:stead-model-reply (get value 'choices'))
  ?>  ?=(^ rows)
  i.rows
++  set-choice
  |=  [value=json next=json]
  ^-  json
  (put value 'choices' [%a ~[next]])
++  set-message
  |=  [value=json next=json]
  ^-  json
  (set-choice value (put (choice value) 'message' next))
++  set-call
  |=  [value=json next=json]
  ^-  json
  (set-message value (put (get (choice value) 'message') 'tool_calls' [%a ~[next]]))
++  call
  ^-  json
  =/  rows  (list-of:stead-model-reply (get (get (choice original) 'message') 'tool_calls'))
  ?>  ?=(^ rows)
  i.rows
++  rejected
  |=  raw=octets:stead-model-material
  ^-  ?
  ?=([%| *] (mule |.((normalize:stead-model-reply material raw))))
++  refuses
  |=  value=json
  ^-  ?
  =/  raw  (emit value)
  (rejected [(met 3 raw) raw])
++  normalized
  |=  value=json
  ^-  reply:stead-model-reply
  =/  raw  (emit value)
  (normalize:stead-model-reply material [(met 3 raw) raw])
++  timing
  |=  value=json
  ^-  json
  (put original 'timings' (put (get original 'timings') 'prompt_ms' value))
++  no-call
  |=  finish=@t
  ^-  json
  =/  message  (put (get (choice original) 'message') 'tool_calls' [%a ~])
  (set-choice original (put (put (choice original) 'finish_reason' [%s finish]) 'message' message))
--
|%
++  test-model-reply-rebuilds-golden-proposal-from-original-bytes
  =/  answer  (normalize:stead-model-reply material [(met 3 reply-wire) reply-wire])
  =/  empty-reasoning
    (set-message original (put (get (choice original) 'message') 'reasoning_content' ~))
  =/  other  (normalized empty-reasoning)
  %-  expect
  !>  ?&  =('tool-proposals' state.answer)
          =('88209ae04a25a1a61af88ba7fbe8b7f9b5579ac9852e36d8b8e01a1affc682d6' digest.answer)
          =('001656fe3ab6f9b63c3a962b8242ddd055a6eccb1ff1c9a5b9d3eaf6fc2cd98a' response-sha256.answer)
          =([%s 'untrusted-proposal'] (get value.answer 'authority'))
          !=(response-sha256.answer response-sha256.other)
          =((get value.answer 'tool_proposals') (get value.other 'tool_proposals'))
      ==
++  test-model-reply-binary-utf8-duplicate-depth-and-size-refusals
  =/  invalid-utf8  (cat 3 '{"id":"' (cat 3 255 '"}'))
  =/  duplicate  '{"id":"a","id":"b"}'
  =/  deep  '[[[[[[[[["x"]]]]]]]]]'
  =/  large  (cat 3 reply-wire (fil 3 32.768 ' '))
  %-  expect
  !>  ?&  (rejected [0 0])
          (rejected [+((met 3 reply-wire)) reply-wire])
          (rejected [(met 3 invalid-utf8) invalid-utf8])
          (rejected [(met 3 duplicate) duplicate])
          (rejected [(met 3 deep) deep])
          (rejected [(met 3 large) large])
      ==
++  test-model-reply-timing-exponents-and-reasoning-are-bounded
  =/  valid  (normalized (timing [%n '1e12']))
  =/  negative-zero  (normalized (timing [%n '-0.0e32']))
  =/  unknown  (put original 'timings' (put (get original 'timings') 'unknown' [%n '1']))
  =/  long  (cat 3 '1e' (fil 3 126 '9'))
  %-  expect
  !>  ?&  =('tool-proposals' state.valid)  =('tool-proposals' state.negative-zero)
          (refuses (timing [%n '1000000000000.0001']))
          (refuses (timing [%n '-0.01']))
          (refuses (timing [%n '1e33']))
          (refuses (timing [%n '1e-33']))
          (refuses (timing [%n long]))
          (refuses (timing [%n (cat 3 long '9')]))
          (refuses unknown)
          (refuses (put original 'timings' (put (get original 'timings') 'cache_n' [%b &])))
          (refuses (set-message original (put (get (choice original) 'message') 'reasoning_content' [%s 'private reasoning'])))
      ==
++  test-model-reply-refusal-incomplete-and-filter-never-propose-doc
  =/  refused  (normalized (set-message original (put (get (choice original) 'message') 'refusal' [%s 'Cannot propose this.'])))
  =/  incomplete  (normalized (no-call 'length'))
  =/  blocked  (normalized (no-call 'content_filter'))
  =/  text  (normalized (no-call 'stop'))
  %-  expect
  !>  ?&  =('refused' state.refused)  =([%a ~] (get value.refused 'tool_proposals'))
          =('incomplete' state.incomplete)  =([%a ~] (get value.incomplete 'tool_proposals'))
          =('blocked' state.blocked)  =([%a ~] (get value.blocked 'tool_proposals'))
          =('text-proposal' state.text)  =([%a ~] (get value.text 'tool_proposals'))
      ==
++  test-model-reply-tool-model-and-usage-pins-reject-spoofs
  =/  function  (get call 'function')
  =/  unknown-tool  (set-call original (put call 'function' (put function 'name' [%s 'run_shell'])))
  =/  extra-argument
    (set-call original (put call 'function' (put function 'arguments' [%s '{"markdown":"proposal","authorized":"yes"}'])))
  =/  usage  (get original 'usage')
  =/  too-many  (set-message original (put (get (choice original) 'message') 'tool_calls' [%a ~[call call]]))
  %-  expect
  !>  ?&  (refuses unknown-tool)  (refuses extra-argument)  (refuses too-many)
          (refuses (put original 'model' [%s 'other-model']))
          (refuses (put original 'created' [%b &]))
          (refuses (put original 'usage' (put usage 'total_tokens' [%n '23'])))
          (refuses (put original 'usage' (put usage 'prompt_tokens' [%n '1537'])))
          (refuses (put original 'usage' (put usage 'completion_tokens' [%n '257'])))
          (refuses (put original 'usage' (put usage 'total_tokens' [%n '22.0'])))
          (refuses (put original 'native_authorized' [%b &]))
          (refuses (set-choice original (put (choice original) 'finish_reason' [%s 'stop'])))
      ==
++  test-model-reply-actual-linefeeds-and-supplementary-unicode
  =/  answer  (normalize:stead-model-reply material [(met 3 unicode-wire) unicode-wire])
  %-  expect
  !>  ?&  =('tool-proposals' state.answer)
          =('dd2f646db9999df6e2b25cdddafc6056475bdd819b398767fab8e91652010a76' response-sha256.answer)
          =('c2651bad2d457261abad7a165760fd8a55acbdceeaa26274d93452128b2bc451' digest.answer)
          =([%s 'untrusted-proposal'] (get value.answer 'authority'))
      ==
--
